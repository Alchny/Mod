{
	"schemaVersion": 1,
	"id": "talismans",
	"version": "${version}",
	"name": "Talismans Mod",
	"description": "A Minecraft mod that adds magical talismans granting special effects when carried in your inventory.",
	"authors": [
		"Kiber"
	],
	"contact": {
		"homepage": "https://github.com/alchny/mod",
		"sources": "https://github.com/alchny/mod"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.kiber.talismans.TalismansMod"
		],
		"client": [
			"com.kiber.talismans.client.TalismansModClient"
		]
	},
	"mixins": [
		"talismans.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
